<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button android:id="@+id/btn_new" style="@style/ToolButton" android:text="@string/action_new" />
            <Button android:id="@+id/btn_docs" style="@style/ToolButton" android:text="@string/action_docs" />
            <Button android:id="@+id/btn_save" style="@style/ToolButton" android:text="@string/action_save" />
            <Button android:id="@+id/btn_save_as" style="@style/ToolButton" android:text="@string/action_save_as" />
            <Button android:id="@+id/btn_select" style="@style/ToolButton" android:text="@string/action_select" />
            <Button android:id="@+id/btn_select_all" style="@style/ToolButton" android:text="@string/action_select_all" />
            <Button android:id="@+id/btn_copy" style="@style/ToolButton" android:text="@string/action_copy" />
            <Button android:id="@+id/btn_cut" style="@style/ToolButton" android:text="@string/action_cut" />
            <Button android:id="@+id/btn_paste" style="@style/ToolButton" android:text="@string/action_paste" />
            <Button android:id="@+id/btn_undo" style="@style/ToolButton" android:text="@string/action_undo" />
            <Button android:id="@+id/btn_smaller" style="@style/ToolButton" android:text="@string/action_smaller" />
            <Button android:id="@+id/btn_bigger" style="@style/ToolButton" android:text="@string/action_bigger" />
            <Button android:id="@+id/btn_import" style="@style/ToolButton" android:text="@string/action_import" />
            <Button android:id="@+id/btn_export" style="@style/ToolButton" android:text="@string/action_export" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/editor_bg"
        android:gravity="top|start"
        android:hint="@string/editor_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="20dp"
        android:scrollbars="vertical"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textCursorDrawable="@null"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />
</LinearLayout>
